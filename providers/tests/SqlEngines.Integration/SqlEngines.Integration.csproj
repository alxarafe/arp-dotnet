    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../Alxarafe.Arp.Cds.PostgreSql/Alxarafe.Arp.Cds.PostgreSql.csproj" />
        <ProjectReference Include="../../Alxarafe.Arp.Cds.MySql/Alxarafe.Arp.Cds.MySql.csproj" />
        <ProjectReference Include="../../Alxarafe.Arp.Cds.SqlServer/Alxarafe.Arp.Cds.SqlServer.csproj" />
        <PackageReference Include="Npgsql" Version="10.0.0" />
        <PackageReference Include="MySqlConnector" Version="3.0.0" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    </ItemGroup>
</Project>
